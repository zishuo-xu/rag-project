# ============ LLM（OpenAI 兼容接口，默认 DeepSeek）============
# 复制本文件为 .env 并填入你的 API Key（.env 已被 gitignore，切勿提交）
# 切换模型只需改 LLM_PROVIDER：deepseek（默认，评测基线口径）| qwen（阿里云百炼）
LLM_PROVIDER=deepseek

OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
# 思考模式：False=关闭思考直接输出（更快更省 token）；True=开启 reasoning
LLM_THINKING_ENABLED=false

# ---- Qwen（仅当 LLM_PROVIDER=qwen 时使用；thinking 关不掉时延迟偏高）----
QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max-preview

# ============ Embedding（本地，无需 API）============
# provider: "local"(sentence-transformers) | "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 仅当 provider=openai 时使用
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============ Rerank（本地 cross-encoder，无需 API）============
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=20

# ============ ChromaDB ============
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_CHUNK_COLLECTION=chunks
CHROMA_SUMMARY_COLLECTION=summaries

# ============ 检索 ============
RETRIEVAL_TOP_K=5
RETRIEVAL_RRF_K=60
# 检索管道接线
USE_SUMMARY_RECALL=true      # L1 摘要索引作为第 5 路召回
USE_CRAG_GATE=true           # CRAG 门控：判断是否需要检索
RECALL_MAX_WORKERS=6         # 多路召回线程池大小
# Parent-Child 检索
USE_PARENT_CHILD=true
PARENT_CHUNK_SIZE=1024
CHILD_CHUNK_SIZE=200
# CRAG 自纠正
USE_CRAG=true
CRAG_RELEVANCE_THRESHOLD=0.5
# Graph RAG
GRAPH_ENABLED=true
GRAPH_MAX_HOPS=2
GRAPH_MAX_ENTITIES=5

# ============ 分块 ============
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SEMANTIC_CHUNK_THRESHOLD=0.75

# ============ 并发控制 ============
MAX_CONCURRENT_REQUESTS=4    # /api/chat 并发闸门
REQUEST_QUEUE_TIMEOUT=30.0   # 排队超时秒数，超时返回 503

# ============ 语义缓存 ============
CACHE_ENABLED=true
CACHE_THRESHOLD=0.92
CACHE_TTL=3600
CACHE_MAX_SIZE=200

# ============ RAG 2.0 深度增强（每项独立开关，失败自动降级）============
USE_AUTOCUT=true                 # F1 Kneedle 自适应截断
USE_ITERATIVE_RETRIEVAL=true     # F2 Self-RAG 迭代检索（质量驱动终止）
MAX_RETRIEVAL_ITERATIONS=2
USE_FAITHFULNESS_CHECK=true      # F3 忠实度自检 + 有界重生成
FAITHFULNESS_THRESHOLD=0.7
FAITHFULNESS_MAX_REGEN=1
USE_QUERY_ROUTER=true            # F4 零 LLM 查询路由
USE_CONTEXTUAL_CHUNKS=true       # F6a 索引期上下文增强（在线零增量）
USE_DECOMPOSITION=true           # F6b 多跳分解

# ============ RAG 3.0 生产级增强 ============
USE_CITATIONS=true               # F7 引用溯源（零在线 LLM）
USE_SPECULATIVE_STREAMING=true   # F8 投机流式（流末校验）
USE_EMBEDDING_CACHE=true         # F9 多级缓存
USE_RERANK_CACHE=true
USE_ANSWER_EXTRACTION=true       # F10 零 LLM 短答案抽取
USE_SELF_CONSISTENCY=false       # F10 自一致性（默认关：3× 生成成本）
USE_HISTORY_REWRITE=true         # F12 历史感知重写（默认零 LLM 启发式）
USE_AGENTIC=false                # F13 Agentic RAG（ReAct 状态机，默认关）
AGENTIC_EVIDENCE_GATE=true       # F13 证据充分度硬门控（零 LLM）

# ============ 延迟治理 ============
LATENCY_BUDGET_MS=25000          # 查询级预算，熔断离群尾（<=0 关闭）
ANSWER_MAX_TOKENS=1024

# ============ F11 生产加固（不配置=不启用，默认零影响）============
API_KEY=                         # 设置后启用 X-API-Key 鉴权
RATE_LIMIT_RPM=0                 # >0 启用按客户端限流
LOG_JSON=false

# ============ 服务 ============
API_HOST=0.0.0.0
API_PORT=8000

# ============ LangSmith（可选）============
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-project
